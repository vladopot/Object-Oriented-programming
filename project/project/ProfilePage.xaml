<Page x:Class="project.ProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:project"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="900"
      Title="ProfilePage">
    <Page.Background>
        <ImageBrush ImageSource="Resources/Background.jpg"></ImageBrush>
    </Page.Background>
    <Page.Resources>
        <Style x:Key="BtnStyle" TargetType="Button">
            <Setter Property="Background" Value="LightGray"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}" >
                            <ContentPresenter HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Content="{TemplateBinding Content}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="ButtonBorder"
                                        Storyboard.TargetProperty="(Background).(SolidColorBrush.Color)"
                                        To="Gray"
                                        Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="ButtonBorder"
                                        Storyboard.TargetProperty="(Background).(SolidColorBrush.Color)"
                                        To="LightGray"
                                        Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.5*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="TextBlock" Text="Loading..." FontSize="24" Foreground="White" Grid.Column="0" Margin="40,50,0,0"></TextBlock>
        <Button Click="NavigateTo" Grid.Column="0" Style="{StaticResource BtnStyle}" x:Name="analyzBtn" Content="analyz" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Height="60" FontSize="16" Margin="0,0,0,180"></Button>
        <Button Click="NavigateTo" Grid.Column="0" Style="{StaticResource BtnStyle}" x:Name="addTrainBtn" Content="AddTrain" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Height="60" FontSize="16" Margin="0,0,0,120"></Button>
        <Button Click="NavigateTo" Grid.Column="0" Style="{StaticResource BtnStyle}" x:Name="plansBtn" Content="Plans" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Height="60" FontSize="16" Margin="0,0,0,60"></Button>
        <Button Click="NavigateTo" Grid.Column="0" Style="{StaticResource BtnStyle}" x:Name="exitBtn" IsCancel="True" Content="Exit" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Height="60" FontSize="16" Margin="0,0,0,0"></Button>

        <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Width="400">

            <StackPanel Orientation="Vertical" Margin="0,10">
                <TextBlock Text="Name" FontSize="20" Foreground="White" HorizontalAlignment="Left" Margin="0,0,0,5"/>
                <TextBox x:Name="firstNameInput" Width="350" Height="40" FontSize="16" />
            </StackPanel>

            <StackPanel Orientation="Vertical" Margin="0,10">
                <TextBlock Text="Surname" FontSize="20" Foreground="White" HorizontalAlignment="Left" Margin="0,0,0,5"/>
                <TextBox x:Name="lastNameInput" Width="350" Height="40" FontSize="16" />
            </StackPanel>

            <StackPanel Orientation="Vertical" Margin="0,10">
                <TextBlock Text="Age" FontSize="20" Foreground="White" HorizontalAlignment="Left" Margin="0,0,0,5"/>
                <TextBox x:Name="ageInput" Width="350" Height="40" FontSize="16" />
            </StackPanel>

            <StackPanel Orientation="Vertical" Margin="0,10">
                <TextBlock Text="Height (cm)" FontSize="20" Foreground="White" HorizontalAlignment="Left" Margin="0,0,0,5"/>
                <TextBox x:Name="heightInput" Width="350" Height="40" FontSize="16" />
            </StackPanel>

            <StackPanel Orientation="Vertical" Margin="0,10">
                <TextBlock Text="Weight (kg)" FontSize="20" Foreground="White" HorizontalAlignment="Left" Margin="0,0,0,5"/>
                <TextBox x:Name="weightInput" Width="350" Height="40" FontSize="16" />
            </StackPanel>

            <StackPanel Orientation="Vertical" Margin="0,10">
                <TextBlock Text="Goal" FontSize="20" Foreground="White" HorizontalAlignment="Left" Margin="0,0,0,5"/>
                <ComboBox x:Name="goalInput" Width="350" Height="40" FontSize="16" SelectedIndex="0">
                    <ComboBoxItem Content="Gain Weight" />
                    <ComboBoxItem Content="Lose Weight" />
                    <ComboBoxItem Content="Maintain Weight" />
                </ComboBox>
            </StackPanel>

            <Button Click="SaveChanges" Style="{StaticResource BtnStyle}" Content="Save Changes" Width="200" Height="50" HorizontalAlignment="Center" Margin="0,20,0,0"/>
        </StackPanel>
        
    </Grid>
</Page>
